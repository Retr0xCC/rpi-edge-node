# ========================================================
# 1. Antigravity Security: Secret boundaries & Vault policy
# ========================================================
# Strict prohibition per AGENTS.MD: Never expose vault passwords
**/.vault_pass*
**/.vault-password*
*.vault_password

# Encrypted Vault files (AES-256 ciphertext carries zero semantic value
# for LLM reasoning and burns thousands of context tokens)
*vault.yml
*vault.yaml
ansible/group_vars/all/vault.yml

# Plaintext secrets, private keys, certificates and env files
*.key
*.pem
*.pfx
*.p12
*.crt
id_rsa*
id_ed25519*
.env
.env.*
*.env
!*.env.j2
secrets/
secrets.yml
private/
credentials/

