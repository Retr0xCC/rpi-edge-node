EULA=TRUE
ONLINE_MODE=TRUE

TYPE=MODRINTH
VERSION=26.2
MODRINTH_MODPACK=adrenaline
MODRINTH_EXCLUDE_FILES=cull-fewer-leaves,dynamic-fps,entityculling,immediatelyfast,ixeris,modmenu,particle-core,sodium
MODRINTH_PROJECTS=fabric-api,easyauth,easywhitelist,skinrestorer,chunky,simple-voice-chat,servux,client-commands,jei,jade,appleskin,tcdcommons,better-stats,alternate-current,clumps,asynclogger,structure-layout-optimizer,vmp-fabric,spark
MODRINTH_DEFAULT_VERSION_TYPE=release
MODRINTH_ALLOWED_VERSION_TYPE=alpha

INIT_MEMORY=3G
MAX_MEMORY=3G
JVM_OPTS=-XX:+UseG1GC -XX:+UseCompactObjectHeaders -XX:+PerfDisableSharedMem -Dfml.readTimeout=90 -Dfml.queryResult=confirm -Djava.library.path=/data/lib
DIFFICULTY=hard
VIEW_DISTANCE=8
SIMULATION_DISTANCE=5
SYNC_CHUNK_WRITES=false
SEED={{ vault_mc_seed }}
MOTD={{ vault_mc_motd }}

PAUSE_WHEN_EMPTY_SECONDS=300
