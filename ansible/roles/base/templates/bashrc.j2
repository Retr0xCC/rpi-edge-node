# ~/.bashrc: executed by bash(1) for non-login shells.
# Managed by Ansible - do not edit manually!

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# Don't put duplicate lines or lines starting with space in the history
HISTCONTROL=ignoreboth

# Append to the history file, don't overwrite it
shopt -s histappend

# Save multi-line commands as a single line in history
shopt -s cmdhist

# History length settings
HISTSIZE=10000
HISTFILESIZE=20000

# Immediately append commands to history file upon execution
if [[ "${PROMPT_COMMAND:-}" != *"history -a"* ]]; then
    while [[ "${PROMPT_COMMAND:-}" =~ [[:space:]\;]$ ]]; do
        PROMPT_COMMAND="${PROMPT_COMMAND%[[:space:]\;]}"
    done
    PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND; }history -a"
fi

# Check window size after each command and update LINES and COLUMNS
shopt -s checkwinsize

# Set variable identifying the chroot environment
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

# Set a colored prompt for 256color terminals
case "$TERM" in
    xterm-color|*-256color) color_prompt=yes;;
esac

if [ "$color_prompt" = yes ]; then
    PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
    PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
unset color_prompt force_color_prompt

# Set terminal window title
case "$TERM" in
xterm*|rxvt*)
    PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
    ;;
*)
    ;;
esac

# Enable color support for ls and add common aliases
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
fi

# Include custom alias definitions if present
if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# Enable programmable bash completion features
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  elif [ -d /usr/share/bash-completion/completions ]; then
    # Fallback when bash-completion package is not yet installed: load systemd unit completions
    for _comp in systemctl journalctl; do
      [ -f "/usr/share/bash-completion/completions/$_comp" ] && . "/usr/share/bash-completion/completions/$_comp"
    done
    unset _comp
  fi
fi

# ========================================================
# Prefix History Search (Native GNU Readline)
# ========================================================
# Search command history matching typed prefix using Up/Down arrow keys.
# Uses native GNU Readline (compiled C inside bash): 0% CPU overhead, zero external
# processes or daemons, instant response (optimized for Raspberry Pi).
bind '"\e[A": history-search-backward' 2>/dev/null || true
bind '"\e[B": history-search-forward' 2>/dev/null || true
bind '"\eOA": history-search-backward' 2>/dev/null || true
bind '"\eOB": history-search-forward' 2>/dev/null || true
bind '"\e[5~": history-search-backward' 2>/dev/null || true
bind '"\e[6~": history-search-forward' 2>/dev/null || true

# ========================================================
# Custom User Environment & Aliases
# ========================================================

export EDITOR="nvim"
export VISUAL="nvim"

alias ccat="source-highlight --failsafe -f esc --src-lang=sh -i"
